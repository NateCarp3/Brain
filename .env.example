# Copy this file to ".env" and fill in real values for local development.
# Never commit the real ".env" file -- it's already in .gitignore.
#
# On your deployment host (Render, Railway, Heroku, etc.) set these same
# names as real environment variables in the platform's dashboard instead
# of using a .env file.

# A long, random string used to sign session cookies. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-string

# MySQL connection settings
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=

# Only needed when connecting to a managed MySQL provider that requires SSL
# (e.g. Aiven). Set this to the path of the downloaded CA certificate file.
# Leave blank for a local MySQL server.
DB_SSL_CA=
